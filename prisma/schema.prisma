generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
}

enum PGType {
  Boys
  Girls
  CoLiving
}

enum RoomType {
  AC
  NonAC
}

enum PGStatus {
  active
  inactive
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  phone        String
  passwordHash String     @map("password_hash")
  roleId       Int        @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status       UserStatus @default(active)
  isActive     Int        @default(1) @map("is_active")
  userPGs      UserPG[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  pg           PG?        @relation(fields: [pGId], references: [id])
  pGId         Int?

  @@map("users")
}

model Tenant {
  id             Int       @id @default(autoincrement())
  pgId           Int       @map("pg_id")
  pg             PG        @relation(fields: [pgId], references: [id], onDelete: Cascade)
  roomId         Int?      @map("room_id")
  room           PGRoom?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  name           String
  phone          String
  aadhar         String
  address        String?
  emergency      String?
  emergencyPhone String?   @map("emergency_phone")
  idProofUrl     String?   @map("id_proof_url")
  photoUrl       String?   @map("photo_url")
  isActive       Int       @default(1) @map("is_active")
  moveInDate     DateTime  @default(now()) @map("move_in_date")
  moveOutDate    DateTime? @map("move_out_date")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  bills          Bill[]
  payments       Payment[]

  @@map("pg_tenants")
}

model Room {
  id            Int      @id @default(autoincrement())
  number        String   @unique
  type          String
  totalBeds     Int      @map("total_beds")
  availableBeds Int      @map("available_beds")
  rent          Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("rooms")
}

model Bed {
  id        Int      @id @default(autoincrement())
  number    String   @unique
  room      String
  status    String   @default("vacant")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("beds")
}

// ============ City & Area Master Models ============
model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  state     String?
  isActive  Int      @default(1) @map("is_active")
  areas     Area[]
  pgs       PG[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cities")
}

model Area {
  id        Int      @id @default(autoincrement())
  name      String
  cityId    Int      @map("city_id")
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  isActive  Int      @default(1) @map("is_active")
  pgs       PG[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, cityId])
  @@map("areas")
}

// PG (Paying Guest) Models
model PG {
  id              Int       @id @default(autoincrement())
  pgName          String    @map("pg_name")
  ownerName       String    @map("owner_name")
  ownerPhone      String    @map("owner_phone")
  ownerEmail      String    @unique @map("owner_email")
  addressLine1    String    @map("address_line1")
  addressLine2    String?   @map("address_line2")
  isActive        Int       @default(1) @map("is_active")
  areaId          Int?      @map("area_id")
  area            Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  cityId          Int?      @map("city_id")
  city            City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  state           String
  latitude        Float
  longitude       Float
  pgType          PGType    @map("pg_type")
  numberOfRooms   Int       @map("number_of_rooms")
  isFoodAvailable Boolean   @default(false) @map("is_food_available")
  status          PGStatus  @default(active)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  rooms           PGRoom[]
  photos          PGPhoto[]
  users           User[]
  userPGs         UserPG[]
  expenses        Expense[]
  tenants         Tenant[]
  bills           Bill[]
  payments        Payment[]

  @@map("pgs")
}

model PGRoom {
  id            Int      @id @default(autoincrement())
  pgId          Int      @map("pg_id")
  pg            PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  roomType      String   @map("room_type")
  roomNumber    String   @map("room_number")
  totalBeds     Int      @map("total_beds")
  availableBeds Int      @map("available_beds")
  pricePerBed   Int      @map("price_per_bed")
  acType        RoomType @map("ac_type")
  tenants       Tenant[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([pgId, roomNumber])
  @@map("pg_rooms")
}

model PGPhotoCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  photos      PGPhoto[]

  @@map("pg_photo_categories")
}

model UserPG {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  pgId       Int      @map("pg_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pg         PG       @relation(fields: [pgId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([userId, pgId])
  @@map("pg_users")
}

enum ExpenseCategory {
  rent
  electricity
  water
  maintenance
  salary
  food
  internet
  other
}

model Expense {
  id          Int             @id @default(autoincrement())
  pgId        Int             @map("pg_id")
  pg          PG              @relation(fields: [pgId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Float
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("expenses")
}

model PGPhoto {
  id         Int             @id @default(autoincrement())
  pgId       Int             @map("pg_id")
  pg         PG              @relation(fields: [pgId], references: [id], onDelete: Cascade)
  categoryId Int             @map("category_id")
  category   PGPhotoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  photoUrl   String          @map("photo_url")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@map("pg_photos")
}

// ============ Billing Models ============

enum BillStatus {
  draft
  pending
  partial
  paid
  overdue
}

enum PaymentMode {
  cash
  upi
  bank_transfer
  cheque
  other
}

enum BillCategory {
  Rent
  Electricity
  Water
  Maintenance
  Salary
  Food
  Internet
  Other
}

model Bill {
  id          Int        @id @default(autoincrement())
  pgId        Int        @map("pg_id")
  pg          PG         @relation(fields: [pgId], references: [id], onDelete: Cascade)
  tenantId    Int        @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billMonth   Int        @map("bill_month")
  billYear    Int        @map("bill_year")
  totalAmount Float      @map("total_amount")
  paidAmount  Float      @default(0) @map("paid_amount")
  dueAmount   Float      @map("due_amount")
  dueDate     DateTime   @map("due_date")
  status      BillStatus @default(pending)
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  items       BillItem[]
  payments    Payment[]

  @@unique([tenantId, billMonth, billYear])
  @@map("bills")
}

model BillItem {
  id        Int          @id @default(autoincrement())
  billId    Int          @map("bill_id")
  bill      Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  label     BillCategory
  amount    Float
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("bill_items")
}

model Payment {
  id          Int         @id @default(autoincrement())
  billId      Int         @map("bill_id")
  bill        Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  pgId        Int         @map("pg_id")
  pg          PG          @relation(fields: [pgId], references: [id], onDelete: Cascade)
  tenantId    Int         @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Float
  mode        PaymentMode
  referenceNo String?     @map("reference_no")
  note        String?
  paidAt      DateTime    @default(now()) @map("paid_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("payments")
}

// ============ Roles Module ============
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  permissions String[]
  isActive    Int      @default(1) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}
